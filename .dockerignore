# .dockerignore

# Git and version control
.git
.gitignore

# Python specific
**/__pycache__/
**/*.pyc
**/*.pyo
**/*.pyd
venv/
.venv/
**/*.egg-info/

# Runtime local
logs/
config/
.dlt/

# Manifests/docs
minio.yaml
values.yaml
pod_templates/
README.md

# IDE and editor config
.vscode/
.idea/

# Environment files
.env
.env.*

# Build and test artifacts
build/
dist/
*.log
.pytest_cache/
htmlcov/